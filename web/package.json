{
  "name": "greed-game-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Greed Game (2-player hidden-bid duel, vs Bot / vs Friend) — Astro + TypeScript web app for greed.sneat.games. Built on @sneat/game-kit; see game-kit/docs/DESIGN.md for the cross-game architecture.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/relativize-dist.mjs",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit && tsc --noEmit --project host-worker/tsconfig.json",
    "lint": "eslint . --ext .ts,.astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "relay": "node ./node_modules/@sneat/game-kit/dist/test-relay.mjs 8787",
    "gen-icons": "node scripts/gen-icons.mjs",
    "host:dev": "wrangler dev --config host-worker/wrangler.jsonc",
    "host:deploy": "wrangler deploy --config host-worker/wrangler.jsonc"
  },
  "dependencies": {
    "@sneat/game-kit": "github:sneat-games/game-kit#v0.1.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@eslint/js": "^9.10.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.10.0",
    "@vite-pwa/astro": "^1.2.0",
    "astro": "^5.0.0",
    "eslint": "^9.10.0",
    "eslint-plugin-astro": "^1.3.0",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "sharp": "^0.33.5",
    "typescript": "^5.7.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.120.1"
  },
  "engines": {
    "node": ">=22"
  }
}
